// NEXORA CMS database schema.
//
// Conventions:
// - Table and column names are snake_case in PostgreSQL (@@map / @map); Prisma models are PascalCase.
// - Constraints Prisma cannot express (CHECK constraints) live in migration SQL and are covered by tests.
// - The connection URL is supplied by prisma.config.ts (migrations) and by the driver adapter (runtime).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Instance-wide installation state. Exactly one row may exist (enforced by CHECK (id = 1)).
/// Written by the setup wizard (Milestone 2); read by the public system status endpoint.
model SystemState {
  id               Int       @id @default(1) @db.SmallInt
  installedAt      DateTime? @map("installed_at") @db.Timestamptz(3)
  installedVersion String?   @map("installed_version") @db.VarChar(64)
  /// SHA-256 of the one-time setup token; cleared when installation completes.
  setupTokenHash   Bytes?    @map("setup_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_state")
}

// ---------------------------------------------------------------------------------------------
// Milestone 2: sites, identity, access control, audit, rate limiting
// ---------------------------------------------------------------------------------------------

/// A website managed by this instance. Exactly one ("default") exists until multi-site support lands;
/// site-scoped data references it so tenancy can be added without a schema rewrite.
model Site {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(64)
  name      String   @db.VarChar(200)
  /// Public base URL (scheme + host [+ path]); used to build absolute links such as password resets.
  baseUrl   String   @map("base_url") @db.VarChar(2048)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleAssignments RoleAssignment[]
  terms           Term[]
  entries         Entry[]
  media           Media[]

  @@map("sites")
}

enum UserStatus {
  active
  suspended

  @@map("user_status")
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Stored normalised (trimmed, lower-case); enforced by a CHECK constraint.
  email             String     @unique @db.VarChar(320)
  displayName       String     @map("display_name") @db.VarChar(120)
  status            UserStatus @default(active)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential          UserCredential?
  sessions            Session[]
  roleAssignments     RoleAssignment[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]
  authoredEntries     Entry[]              @relation("EntryAuthor")
  editedEntries       Entry[]              @relation("EntryLastEditor")
  trashedEntries      Entry[]              @relation("EntryTrashedBy")
  entryRevisions      EntryRevision[]
  uploadedMedia       Media[]

  @@index([status])
  @@map("users")
}

/// Password hashes live apart from user rows so ordinary user queries can never select them.
model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  /// Argon2id PHC string.
  passwordHash String   @map("password_hash") @db.VarChar(255)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// Server-side session. The cookie carries a random token; only its SHA-256 digest is stored.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     Bytes     @unique @map("token_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry; idle expiry is derived from last_seen_at.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(64)
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(500)
  /// Built-in roles cannot be deleted or renamed.
  isSystem    Boolean  @default(false) @map("is_system")
  /// Holds every capability, including ones registered later (Super Administrator).
  grantsAll   Boolean  @default(false) @map("grants_all")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  capabilities RoleCapability[]
  assignments  RoleAssignment[]

  @@map("roles")
}

/// Registry of capabilities. Core capabilities are seeded by migrations; plugins add theirs (M6).
model Capability {
  key         String @id @db.VarChar(100)
  category    String @db.VarChar(64)
  description String @db.VarChar(300)

  roles RoleCapability[]

  @@map("capabilities")
}

model RoleCapability {
  roleId        String @map("role_id") @db.Uuid
  capabilityKey String @map("capability_key") @db.VarChar(100)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityKey], references: [key], onDelete: Cascade)

  @@id([roleId, capabilityKey])
  @@index([capabilityKey])
  @@map("role_capabilities")
}

/// One role per user per site.
model RoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, siteId])
  @@index([roleId])
  @@map("role_assignments")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Append-only security audit trail. UPDATE and DELETE are rejected by a database trigger.
model AuditEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  action      String   @db.VarChar(100)
  /// Users are never hard-deleted while audit events reference them (RESTRICT keeps the trail intact).
  actorUserId String?  @map("actor_user_id") @db.Uuid
  targetType  String?  @map("target_type") @db.VarChar(64)
  targetId    String?  @map("target_id") @db.VarChar(64)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(128)
  /// Small, validated, secret-free context (never passwords, tokens or full request bodies).
  metadata    Json     @default("{}")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([action, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

/// Fixed-window rate-limit counters (PostgreSQL fallback when no Redis-compatible cache is configured).
model RateLimitBucket {
  /// "<scope>:<subject>:<window index>"
  key       String   @id @db.VarChar(255)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------------------------
// Milestone 3: background jobs
// ---------------------------------------------------------------------------------------------

enum JobStatus {
  pending
  running
  succeeded
  dead

  @@map("job_status")
}

/// Durable job queue. Rows are inserted in the same transaction as the change that needs them and
/// claimed with FOR UPDATE SKIP LOCKED. A failed attempt returns the job to `pending` with a later run_at;
/// after max_attempts it becomes `dead`.
model Job {
  id               String    @id @default(uuid(7)) @db.Uuid
  name             String    @db.VarChar(100)
  payload          Json      @default("{}")
  status           JobStatus @default(pending)
  attempts         Int       @default(0)
  maxAttempts      Int       @default(5) @map("max_attempts")
  runAt            DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy         String?   @map("locked_by") @db.VarChar(120)
  lastError        String?   @map("last_error") @db.VarChar(2000)
  /// At most one job per key exists; released when the job finishes unless the caller keeps it
  /// (recurring tasks keep it so each schedule slot runs once).
  dedupeKey        String?   @unique @map("dedupe_key") @db.VarChar(200)
  /// false for recurring tasks: the key stays until the row is purged, so a slot can never run twice.
  releaseDedupeKey Boolean   @default(true) @map("release_dedupe_key")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@index([name, status])
  @@index([finishedAt])
  @@map("jobs")
}

/// Heartbeats of running workers (embedded or standalone), shown on the jobs page.
model JobWorker {
  id         String   @id @db.VarChar(120)
  hostname   String   @db.VarChar(255)
  pid        Int
  startedAt  DateTime @map("started_at") @db.Timestamptz(3)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)

  @@index([lastSeenAt])
  @@map("job_workers")
}

// ---------------------------------------------------------------------------------------------
// Milestone 3: content model and media
// ---------------------------------------------------------------------------------------------

/// Content type definition (instance-wide). Post and Page are built in; custom types carry custom fields.
model ContentType {
  id               String   @id @default(uuid(7)) @db.Uuid
  key              String   @unique @db.VarChar(32)
  name             String   @db.VarChar(100)
  pluralName       String   @map("plural_name") @db.VarChar(100)
  description      String   @default("") @db.VarChar(500)
  hierarchical     Boolean  @default(false)
  hasBody          Boolean  @default(true) @map("has_body")
  hasExcerpt       Boolean  @default(true) @map("has_excerpt")
  hasFeaturedImage Boolean  @default(true) @map("has_featured_image")
  isSystem         Boolean  @default(false) @map("is_system")
  /// Custom field definitions; validated by the API against the shared field-definition schema.
  fields           Json     @default("[]")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  taxonomies ContentTypeTaxonomy[]
  entries    Entry[]

  @@map("content_types")
}

model Taxonomy {
  id           String   @id @default(uuid(7)) @db.Uuid
  key          String   @unique @db.VarChar(32)
  name         String   @db.VarChar(100)
  pluralName   String   @map("plural_name") @db.VarChar(100)
  description  String   @default("") @db.VarChar(500)
  hierarchical Boolean  @default(false)
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  contentTypes ContentTypeTaxonomy[]
  terms        Term[]

  @@map("taxonomies")
}

model ContentTypeTaxonomy {
  contentTypeId String @map("content_type_id") @db.Uuid
  taxonomyId    String @map("taxonomy_id") @db.Uuid

  contentType ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  taxonomy    Taxonomy    @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  @@id([contentTypeId, taxonomyId])
  @@index([taxonomyId])
  @@map("content_type_taxonomies")
}

model Term {
  id          String   @id @default(uuid(7)) @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  taxonomyId  String   @map("taxonomy_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @db.VarChar(200)
  slug        String   @db.VarChar(200)
  description String   @default("") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  site     Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  taxonomy Taxonomy    @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  parent   Term?       @relation("TermHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Term[]      @relation("TermHierarchy")
  entries  EntryTerm[]

  @@unique([siteId, taxonomyId, slug])
  @@index([taxonomyId, parentId])
  @@map("terms")
}

enum EntryStatus {
  draft
  pending
  scheduled
  published

  @@map("entry_status")
}

/// A piece of content of some content type. Trash is orthogonal to status (trashed_at), so restoring
/// returns the entry to the status it had. `path` is the slug chain from the root ("about/team") and is
/// unique per site and type; for non-hierarchical types it equals the slug.
model Entry {
  id              String      @id @default(uuid(7)) @db.Uuid
  siteId          String      @map("site_id") @db.Uuid
  contentTypeId   String      @map("content_type_id") @db.Uuid
  authorId        String      @map("author_id") @db.Uuid
  lastEditorId    String?     @map("last_editor_id") @db.Uuid
  parentId        String?     @map("parent_id") @db.Uuid
  title           String      @db.VarChar(300)
  slug            String      @db.VarChar(200)
  path            String      @db.VarChar(2000)
  status          EntryStatus @default(draft)
  excerpt         String      @default("") @db.VarChar(1000)
  /// Rich-text document (ProseMirror JSON) validated against the shared allowlist schema.
  body            Json        @default("{\"type\":\"doc\",\"content\":[]}")
  /// Custom field values keyed by field key.
  fields          Json        @default("{}")
  /// Lower-cased title, excerpt and body text for admin search.
  searchText      String      @default("") @map("search_text")
  featuredMediaId String?     @map("featured_media_id") @db.Uuid
  /// Publication time: when it went live, or (status = scheduled) when it will.
  publishedAt     DateTime?   @map("published_at") @db.Timestamptz(3)
  trashedAt       DateTime?   @map("trashed_at") @db.Timestamptz(3)
  trashedById     String?     @map("trashed_by_id") @db.Uuid
  /// Optimistic concurrency token, incremented on every write.
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  site          Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentType   ContentType     @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)
  author        User            @relation("EntryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  lastEditor    User?           @relation("EntryLastEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  trashedBy     User?           @relation("EntryTrashedBy", fields: [trashedById], references: [id], onDelete: SetNull)
  parent        Entry?          @relation("EntryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Entry[]         @relation("EntryHierarchy")
  featuredMedia Media?          @relation(fields: [featuredMediaId], references: [id], onDelete: SetNull)
  terms         EntryTerm[]
  revisions     EntryRevision[]

  @@unique([siteId, contentTypeId, path])
  @@index([siteId, contentTypeId, trashedAt, updatedAt])
  @@index([authorId])
  @@index([parentId])
  @@index([status, publishedAt])
  @@index([trashedAt])
  @@index([featuredMediaId])
  @@map("entries")
}

model EntryTerm {
  entryId String @map("entry_id") @db.Uuid
  termId  String @map("term_id") @db.Uuid

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  term  Term  @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([entryId, termId])
  @@index([termId])
  @@map("entry_terms")
}

/// Snapshot of an entry's editable content after a save. Bounded per entry by the revision retention.
model EntryRevision {
  id           String   @id @default(uuid(7)) @db.Uuid
  entryId      String   @map("entry_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  entryVersion Int      @map("entry_version")
  title        String   @db.VarChar(300)
  snapshot     Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry  Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@map("entry_revisions")
}

/// An uploaded file. `storage_key` is server-generated (date, random id, sanitised name) and never taken
/// from user input. Image variants are generated by a background job.
model Media {
  id         String   @id @default(uuid(7)) @db.Uuid
  siteId     String   @map("site_id") @db.Uuid
  uploaderId String   @map("uploader_id") @db.Uuid
  storageKey String   @unique @map("storage_key") @db.VarChar(500)
  /// Original file name (sanitised), shown in the library.
  filename   String   @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  Int      @map("size_bytes")
  width      Int?
  height     Int?
  title      String   @db.VarChar(255)
  altText    String   @default("") @map("alt_text") @db.VarChar(500)
  caption    String   @default("") @db.VarChar(1000)
  /// [{ width, height, key, mimeType, sizeBytes }] for responsive image variants.
  variants   Json     @default("[]")
  /// SHA-256 of the stored file.
  checksum   Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  site              Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  uploader          User    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  featuredInEntries Entry[]

  @@index([siteId, createdAt])
  @@index([uploaderId])
  @@index([mimeType])
  @@map("media")
}
