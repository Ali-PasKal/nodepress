{
  "name": "@nexora/site-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA public site: server-renders published content from the Delivery API with the active theme",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexora/shared": "workspace:*",
    "@nexora/theme-sdk": "workspace:*",
    "@nexora/theme-starter": "workspace:*",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
