{
  "name": "@nexora/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Types, a test harness and packaging for NEXORA plugins",
  "type": "module",
  "bin": {
    "nexora-plugin": "./bin/nexora-plugin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "import": "./dist/pack.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@nexora/plugin-runtime": "workspace:*",
    "@nexora/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
