# Dependencies' `engines` fields are reported as warnings instead of hard errors: many tools exclude
# non-LTS Node.js releases (e.g. 23.x) on principle even where they work. The project's real support
# range is the root package.json `engines.node`, which `pnpm nexora doctor` checks.
engine-strict=false
auto-install-peers=false
strict-peer-dependencies=false
save-exact=true
