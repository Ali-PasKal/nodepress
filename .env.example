# NEXORA CMS — example environment for LOCAL DEVELOPMENT ONLY.
#
# Copy to .env (`pnpm nexora dev` does this automatically). These values are deliberately weak and
# public: with NODE_ENV=production the API refuses to start while they are still in use.
# Full reference: docs/development/environment.md

NODE_ENV=development

# --- HTTP -------------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
# Number of trusted reverse-proxy hops, or a comma-separated list of proxy addresses/subnets.
# TRUST_PROXY=1
# Honour X-Request-Id set by a trusted proxy (only enable behind a proxy that overwrites it).
# TRUST_REQUEST_ID_HEADER=false
# Exact origins allowed to call the API cross-origin with credentials. Empty = same-origin only.
# CORS_ALLOWED_ORIGINS=
# REQUEST_BODY_LIMIT=1mb
# REQUEST_TIMEOUT_MS=30000
# SHUTDOWN_DELAY_MS=0

# --- PostgreSQL (docker compose service "postgres") -------------------------------------------
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_password
POSTGRES_DB=nexora
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nexora:nexora_dev_password@localhost:5432/nexora
# Optional: a separate, more privileged role used only by migrations.
# MIGRATION_DATABASE_URL=
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Cache (docker compose service "valkey"); optional ----------------------------------------
VALKEY_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Logging ----------------------------------------------------------------------------------
LOG_LEVEL=info
# "pretty" is for local development only; production requires "json".
LOG_FORMAT=pretty

# --- API documentation (Swagger UI at /api/docs; enabled by default outside production) ------
# OPENAPI_ENABLED=true

# --- Tests (defaults shown) -------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://nexora:nexora_dev_password@localhost:5432/nexora_test
# TEST_REDIS_URL=redis://localhost:6379
# E2E_DATABASE_URL=postgresql://nexora:nexora_dev_password@localhost:5432/nexora_e2e

# --- Full-stack container profile (docker compose --profile app) ------------------------------
# APP_PORT=8080
